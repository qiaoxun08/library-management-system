# =============================================================
# 环境变量模板：复制为 .env 后填写（.env 已被 gitignore，不要提交）
#   cp .env.example .env
# =============================================================

# MySQL root 密码（docker-compose 必填，无弱默认值）
DB_PASSWORD=change-me-strong-password

# Redis 访问密码（docker-compose 必填）
REDIS_PASSWORD=change-me-redis-password

# JWT 签名密钥，必须 ≥32 字节随机串
# 生成方式：openssl rand -base64 48
JWT_SECRET=

# AES 字段加密密钥（手机号等敏感字段加密用），32 字节
# 生成方式：openssl rand -base64 32
AES_SECRET_KEY=
